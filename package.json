{
  "name": "ps5-vision",
  "version": "0.1.0",
  "private": true,
  "description": "Play a PS5 in any web browser, including Apple Vision Pro: a Mac bridge that turns Remote Play into WebRTC.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/THEMANINHOLLYWOOD/ps5-vision.git"
  },
  "homepage": "https://github.com/THEMANINHOLLYWOOD/ps5-vision#readme",
  "bugs": {
    "url": "https://github.com/THEMANINHOLLYWOOD/ps5-vision/issues"
  },
  "keywords": [
    "ps5",
    "remote-play",
    "webrtc",
    "vision-pro",
    "visionos",
    "chiaki",
    "game-streaming"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "start": "node server/index.js",
    "mac": "node server/index.js --local --open",
    "demo": "node server/index.js --demo",
    "link": "node server/link.js",
    "autostart": "bash scripts/autostart.sh",
    "vision": "open visionos/PS5Vision.xcodeproj",
    "vision:install": "bash scripts/install-vision.sh",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {
    "node-datachannel": "^0.33.6"
  }
}
